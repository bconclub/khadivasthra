# Nginx Configuration Example
# For serving Next.js + PHP Admin on same domain
# Place in: /etc/nginx/sites-available/khadivasthra

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com;
    
    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yourdomain.com www.yourdomain.com;
    
    # SSL Certificate Configuration
    ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    
    # Root directory
    root /var/www/khadivasthra;
    index index.html index.php;
    
    # Logging
    access_log /var/log/nginx/khadivasthra_access.log;
    error_log /var/log/nginx/khadivasthra_error.log;
    
    # ============================================
    # ADMIN PANEL - PHP Routes
    # Must come BEFORE Next.js routes
    # ============================================
    location /admin {
        alias /var/www/khadivasthra/admin;
        
        # Security: Prevent directory listing
        autoindex off;
        
        # Try files in order
        try_files $uri $uri/ /admin/index.php?$query_string;
        
        # PHP processing
        location ~ \.php$ {
            include fastcgi_params;
            fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $request_filename;
            fastcgi_param PATH_INFO $fastcgi_path_info;
        }
        
        # Deny access to sensitive files
        location ~ /\.(json|log|md)$ {
            deny all;
            return 404;
        }
    }
    
    # Admin API routes
    location /admin/api {
        alias /var/www/khadivasthra/admin/api;
        try_files $uri $uri/ /admin/api/$uri.php?$query_string;
        
        location ~ \.php$ {
            include fastcgi_params;
            fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $request_filename;
        }
    }
    
    # ============================================
    # NEXT.JS APP - All Other Routes
    # ============================================
    location / {
        # If Next.js is running as a service
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # OR if using static export:
        # try_files $uri $uri/ /index.html;
    }
    
    # Next.js static files (if using static export)
    location /_next/static {
        alias /var/www/khadivasthra/.next/static;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }
    
    # Next.js images
    location /images {
        alias /var/www/khadivasthra/public/images;
        expires 30d;
        add_header Cache-Control "public";
    }
    
    # Public assets
    location /_next {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
    
    # Deny access to hidden files
    location ~ /\. {
        deny all;
        return 404;
    }
}

