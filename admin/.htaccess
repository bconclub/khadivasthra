# Apache configuration for admin folder
# Ensures PHP API files are processed correctly alongside Next.js static files

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # Don't rewrite if file exists (index.html, PHP files, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # For the root admin URL, serve index.html (Next.js admin page) if it exists
    RewriteCond %{DOCUMENT_ROOT}/admin/index.html -f
    RewriteRule ^$ index.html [L]

    # Fallback to index.php if no index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^$ index.php [L]
</IfModule>

# Security: Prevent direct access to sensitive files
<FilesMatch "\.(json|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow access to PHP files
<FilesMatch "\.php$">
    Order allow,deny
    Allow from all
</FilesMatch>

